{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build current session",
      "type": "shell",
      "command": "make",
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "flash current session",
      "type": "shell",
      "command": "make flash",
      "options": {
        "cwd": "${fileDirname}"
      },
      "dependsOn": "build current session"
    },
    {
      "label": "clean current session",
      "type": "shell",
      "command": "make clean",
      "options": {
        "cwd": "${fileDirname}"
      }
    }
  ]
}
